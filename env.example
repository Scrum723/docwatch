# DOC Watch — copy to .env and adjust as needed
# Demo runs with zero keys when MOCK_RING=true (default)

PORT=8787
HOST=127.0.0.1

# National Weather Service — free, no key. Descriptive User-Agent required.
NWS_USER_AGENT=DOCWatch/1.0 (contact: cclot1@brockport.edu; https://github.com/Scrum723/docwatch)

# Optional: xAI Grok for plain-English risk + spoken briefing enhancement
# If unset, templated briefing/advice copy is used so the demo still runs.
XAI_API_KEY=
XAI_MODEL=grok-3-mini
XAI_BASE_URL=https://api.x.ai/v1

# Ring Partner API — optional. Default mock mode for tonight's demo.
# Never claim live worldwide camera weather instruments.
MOCK_RING=true
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_REFRESH_TOKEN=

# Default location key from data/locations.json
DEFAULT_LOCATION=rochester
